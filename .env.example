# ==============================================================================
# LearnLoop AI - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your live '.env' file containing real secrets to version control.
# ==============================================================================

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg2://tutor:password@localhost:5432/learnloop

# Google Gemini API Key
# Obtain your key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Selections
TUTOR_MODEL=gemini-1.5-pro
VERIFIER_MODEL=gemini-1.5-flash

# Embeddings & Audio Models
EMBED_DIM=1024
WHISPER_MODEL=small

# Storage
MEDIA_DIR=data/media

# RAG & Retrieval Tuning
RETRIEVE_TOP_K=20
RERANK_TOP_N=6
REFUSAL_SCORE_THRESHOLD=0.5
MAX_CONTEXT_TOKENS=4000

# Frontend API Endpoint (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
